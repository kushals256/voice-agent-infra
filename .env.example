# Copy to .env and fill in. Loaded by scripts/deploy.sh (as TF_VAR_*) and by the
# bot for local runs. Never commit the real .env.
DEEPGRAM_API_KEY=your_deepgram_api_key
# Optional: STT + Aura TTS share this key. TTS voice (default aura-2-helena-en):
# DEEPGRAM_TTS_VOICE=aura-2-helena-en
OPENAI_API_KEY=unused
# NVIDIA NIM Llama (preferred LLM when OpenAI has no credits)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
