# ── Local-only (never commit) ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example

# Terraform state + provider cache (regenerated by `terraform init`)
infra/.terraform/
*.tfstate
*.tfstate.*
crash.log

# Python / tooling caches
__pycache__/
*.py[cod]
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# ── Everything else is part of the repo and should be committed: ───────────
#   bot/  infra/  harness/  scripts/  _reference/  README.md
#   harness/results/*.json  (test artifacts)
